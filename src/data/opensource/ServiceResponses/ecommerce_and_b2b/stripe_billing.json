        "api_version": "string (Stripe API version date string, e.g. \"2024-06-20\")",
        "created": "integer (Unix epoch timestamp in seconds)",
        "type": "string (event topic: \"checkout.session.completed\")",
        "data": {
          "object": {
            "id": "string (Checkout Session ID: \"cs_...\")",
            "object": "string (\"checkout.session\")",
            "amount_total": "integer (total in cents / smallest currency unit)",
            "currency": "string (lowercase 3-letter ISO code)",
            "customer": "string (\"cus_...\")",
            "customer_email": "string | null",
            "payment_status": "string (\"paid\" | \"unpaid\" | \"no_payment_required\")",
            "status": "string (\"complete\" | \"expired\" | \"open\")",
            "mode": "string (\"payment\" | \"setup\" | \"subscription\")",
            "subscription": "string (\"sub_...\") | null"
          }
        }
      }
