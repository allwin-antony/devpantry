  "endpoints": {
    "payment_intents": "POST /v1/payment_intents",
    "customers": "POST /v1/customers",
    "subscriptions": "POST /v1/subscriptions",
    "checkout_sessions": "POST /v1/checkout/sessions",
    "webhooks": "POST (your server webhook endpoint)"
  }
}