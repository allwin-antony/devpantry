      "data_types": {
        "id": "string (PaymentIntent ID starting with \"pi_\")",
        "object": "string (always \"payment_intent\")",
        "amount": "integer (amount in smallest currency unit, e.g. 2000 = 0.00)",
        "amount_received": "integer (captured amount in smallest currency unit)",
        "capture_method": "string (\"automatic\" | \"manual\")",
        "client_secret": "string (confidential token for frontend Stripe Elements integration)",
        "currency": "string (3-letter ISO code in lowercase, e.g. \"usd\")",
        "customer": "string (Customer ID starting with \"cus_\") | null",
        "description": "string | null",
        "status": "string (\"requires_payment_method\" | \"requires_confirmation\" | \"requires_action\" | \"processing\" | \"requires_capture\" | \"canceled\" | \"succeeded\")",
        "payment_method": "string (PaymentMethod ID starting with \"pm_\") | null",
        "payment_method_types": "array[string] (e.g. [\"card\"])",
        "metadata": "object (key-value dictionary of strings)",
        "created": "integer (Unix epoch timestamp in seconds)"
      }
    },
    "customer_object": {
      "description": "Returned by POST /v1/customers or GET /v1/customers/{id}",
