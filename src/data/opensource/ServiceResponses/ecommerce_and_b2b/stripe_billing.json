        "current_period_end": "integer (Unix epoch timestamp in seconds)",
        "items": {
          "object": "string (\"list\")",
          "data": "array[object] (list of subscription line items with price, quantity, interval)"
        },
        "latest_invoice": "string (Invoice ID starting with \"in_\")"
