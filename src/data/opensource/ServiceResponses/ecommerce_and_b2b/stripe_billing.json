        "id": "string (Customer ID starting with \"cus_\")",
        "object": "string (always \"customer\")",
        "name": "string | null",
        "email": "string | null",
        "balance": "integer (current balance in smallest currency unit, negative = credit)",
        "currency": "string (3-letter ISO code in lowercase) | null",
        "delinquent": "boolean (true if customer has past-due invoices)",
        "invoice_prefix": "string (prefix for generated invoices)",
        "invoice_settings": {
          "custom_fields": "array[object] | null",
          "default_payment_method": "string (\"pm_...\") | null"
        },
        "created": "integer (Unix epoch timestamp in seconds)"
      }
    },
