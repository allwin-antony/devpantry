{
  "name": "devpantry",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "NEXT_PUBLIC_SIGNALING_URL": "wss://devpantry.santonyallwin.workers.dev"
  },
  "main": "./src/workers/collaboration/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOM",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    }
  ]
}
